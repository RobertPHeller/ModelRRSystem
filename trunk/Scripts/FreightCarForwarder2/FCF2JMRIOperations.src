## @defgroup FCF2JMRIOperations FCF2JMRIOperations
# @brief Freight Car Forwarder (V2) database to JMRI Operations XML files
#
# @section SYNOPIS
#
# FCF2JMRIOperations SystemFile JMRI_Output_dir
#
# @section DESCRIPTION
#
# @section PARAMETERS
#
# @arg SystemFile The name of a system file to load
# @arg JMRI_Output_dir Output directory for JMRI Operations XML files
# @par
# @section AUTHOR
# Robert Heller \<heller\@deepsoft.com\>
#

set argv0 [file join [file dirname [info nameofexecutable]] FCFMain]
namespace eval MRRSystem {variable FCFCLASSES_VERSION}
set MRRSystem::FCFCLASSES_VERSION [package require Fcfclasses]
package require gettext
package require snit
package require ParseXML

set msgfiles [::msgcat::mcload [file join [file dirname [file dirname [file dirname \
                                                        [info script]]]] Messages]]
#puts stderr "*** msgfiles = $msgfiles"

snit::type FCF2JMRIOperations {
    pragma -hastypeinfo    no
    pragma -hastypedestroy no
    pragma -hasinstances   no
    typevariable OutputDirectory
    typevariable XMLHeader {<?xml version="1.0" encoding="UTF-8"?>}
    typemethod WriteXMLHeader {fp} {
        puts $fp $XMLHeader
    }
    typevariable OPSDTD_cars {/xml/DTD/operations-cars.dtd}
    typevariable OPSDTD_config {/xml/DTD/operations-config.dtd}
    typevariable OPSDTD_engines {/xml/DTD/operations-engines.dtd}
    typevariable OPSDTD_locations {/xml/DTD/operations-locations.dtd}
    typevariable OPSDTD_routes {/xml/DTD/operations-routes.dtd}
    typevariable OPSDTD_trains {/xml/DTD/operations-trains.dtd}
    typemethod WriteDOCTYPEHeader {fp doctype} {
        puts $fp [format {<!DOCTYPE operations-config SYSTEM "%s">} $doctype]
    }
    typevariable OPSXSLT_cars {/xml/XSLT/operations-cars.xsl}
    typevariable OPSXSLT_config {/xml/XSLT/operations-config.xsl}
    typevariable OPSXSLT_engines {/xml/XSLT/operations-engines.xsl}
    typevariable OPSXSLT_locations {/xml/XSLT/operations-locations.xsl}
    typevariable OPSXSLT_routes {/xml/XSLT/operations-routes.xsl}
    typevariable OPSXSLT_trains {/xml/XSLT/operations-trains.xsl}
    typemethod WriteStylesheetHeader {fp stylesheet} {
        puts $fp [format {<?xml-stylesheet href="%s" type="text/xsl"?>} stylesheet]
    }
    typevariable Filename_config {Operations.xml}
    typevariable Filename_locations {OperationsLocationRoster.xml}
    typevariable Filename_routes {OperationsRouteRoster.xml}
    typevariable Filename_trains {OperationsTrainRoster.xml}
    typevariable Filename_cars {OperationsCarRoster.xml}
    typeconstructor {
        if {$::argc < 2} {
            error [_ "Missing parameters: SystemFile and JMRI_Output_dir"]
            exit 99
        }
        set fileName [lindex $::argv 0]
        if {[catch {System TheSystem [file nativename "$fileName"] 1} message]} {
            error [_ "Problem loading system file (%s): %s" $fileName $message]
            exit 98
        }
        set OutputDirectory [lindex $::argv 1]
        if {[file isdirectory $OutputDirectory] && 
            [llength [glob -nocomplain [file join $OutputDirectory "*.xml"]]] > 0} {
            error [_ "Output directory (%s) exists and is not empty!" $OutputDirectory]
            exit 97
        }
        if {[file exists $OutputDirectory] &&
            ![file isdirectory $OutputDirectory]} {
            error [_ "Output directory (%s) exists and is not a directory!" $OutputDirectory]
            exit 96
        }
        if {![file exists $OutputDirectory]} {
            file mkdir $OutputDirectory
        }
        set operations_config [ParseXML %AUTO% {<operations-config />}]
        set config [$operations_config getElementsByTagName {operations-config}]
        set comment [SimpleDOMElement %AUTO% -tag "!"]
        $comment setdata [format {Written by FCF2JMRIOperations %s on %s} \
                          $MRRSystem::FCFCLASSES_VERSION \
                          [clock format [clock seconds] -format {%+}]]
        $config addchild $comment
        set railroad [SimpleDOMElement %AUTO% -tag "railRoad" \
                      -attributes [list name [TheSystem SystemName]]]
        $config addchild $railroad
        set fp [open [file join $OutputDirectory $Filename_config] w]
        $type WriteXMLHeader $fp
        $type WriteStylesheetHeader $fp $OPSXSLT_config
        $type WriteDOCTYPEHeader $fp $OPSDTD_config
        $operations_config displayTree $fp
        close $fp
        $operations_config destroy
        set operations_locations [ParseXML %AUTO% {<operations-config/>}]
        set config [$operations_locations getElementsByTagName {operations-config}]
        set comment [SimpleDOMElement %AUTO% -tag "!"]
        $comment setdata [format {Written by FCF2JMRIOperations %s on %s} \
                          $MRRSystem::FCFCLASSES_VERSION \
                          [clock format [clock seconds] -format {%+}]]
        $config addchild $comment
        set divisions_node [SimpleDOMElement %AUTO% -tag "divisions"]
        $config addchild $divisions_node
        set divisions [TheSystem DivisionIndexList]
        foreach did $divisions {
            set division [TheSystem TheDivision $did]
            set division_node [SimpleDOMElement %AUTO% -tag "division" \
                               -attributes [list id $did \
                                            name [$division Name]]]
            $divisions_node addchild $division_node
        }
        set stations  [TheSystem StationIndexList]
        set locations_node [SimpleDOMElement %AUTO% -tag "locations"]
        $config addchild $locations_node
        foreach sid $stations {
            set station [TheSystem TheStation $sid]
            set division [$station MyDivision]
            set mydid 0
            foreach did $divisions {
                if {$division eq [TheSystem TheDivision $did]} {
                    set mydid $did
                    break
                }
            }
            set location_node [SimpleDOMElement %AUTO% -tag "location" \
                               -attributes [list id $sid \
                                            name [$station Name] \
                                            divisionId $mydid]]
            set locationTypeList [SimpleDOMElement %AUTO% -tag "types"]
            $location_node addchild $locationTypeList
            $locations_node addchild $location_node
            for {set i 0} {$i < [$station NumberOfIndustries]} {incr i} {
                set industry [$station TheIndustry $i]
                set industryId [GetIndustryId $industry]
                set trackId [format {%ds%d} $industryId $sid]
                set loads [split [$industry LoadsAccepted] {}]
                set empties [split [$industry EmptiesAccepted] {}]
                set attributes [list id $trackId \
                                name [$industry Name] \
                                length [$industry TrackLen] \
                                trackType Spur]
                if {[llength $loads] > 0 || [llength $empties] > 0} {
                    lappend attributes carLoadOption Include
                }
                set tracknode [SimpleDOMElement %AUTO% -tag "track" \
                               -attributes $attributes]
                $location_node addchild $tracknode
                set trackTypeList [SimpleDOMElement %AUTO% -tag "types"] 
                $tracknode addchild $trackTypeList
                set trackCarLoadsList [SimpleDOMElement %AUTO% -tag "carLoads"]
                $tracknode addchild $trackCarLoadsList
                foreach ct $loads {
                    set cartype [TheSystem TheCarType "$ct"]
                    set JMRICarType $cartypeMap($ct)
                    set needType yes
                    foreach cartype [$trackTypeList getElementsByTagName carType] {
                        if {[$cartype attribute name] eq $JMRICarType} {
                            set needType no
                            break
                        }
                    }
                    if {$needType} {
                        $trackTypeList addchild [SimpleDOMElement %AUTO% \
                                                 -tag "carType" \
                                                 -attributes [list name $JMRICarType]]
                    }
                    set LoadName [format "%s &amp; L" $JMRICarType]
                    set needload yes
                    foreach load [$trackCarLoadsList getElementsByTagName carLoad] {
                        if {[$load attribute name] eq $LoadName} {
                            set needload no
                            break
                        }
                    }
                    if {$needload} {
                        $trackCarLoadsList addchild [SimpleDOMElement %AUTO% \
                                                    -tag "carLoad" \
                                                    -attributes [list name $LoadName]]
                    }
                    set needtype yes
                    foreach ctype [$locationTypeList getElementsByTagName carType] {
                        if {[$ctype attribute name] eq $JMRICarType} {
                            set needtype no
                            break
                        }
                    }
                    if {$needtype} {
                        $locationTypeList addchild [SimpleDOMElement %AUTO% \
                                                    -tag "carType" \
                                                    -attributes [list name $JMRICarType]]
                    }
                }
                foreach ct $empties {
                    if {$ct  in $loads} {continue}
                    set cartype [TheSystem TheCarType "$ct"]
                    set JMRICarType $cartypeMap($ct)
                    set needType yes
                    foreach cartype [$trackTypeList getElementsByTagName carType] {
                        if {[$cartype attribute name] eq $JMRICarType} {
                            set needType no
                            break
                        }
                    }
                    if {$needType} {
                        $trackTypeList addchild [SimpleDOMElement %AUTO% \
                                                 -tag "carType" \
                                                 -attributes [list name $JMRICarType]]
                    }
                    set LoadName [format "%s &amp; E" $JMRICarType]
                    set needload yes
                    foreach load [$trackCarLoadsList getElementsByTagName carLoad] {
                        if {[$load attribute name] eq $LoadName} {
                            set needload no
                            break
                        }
                    }
                    if {$needload} {
                        $trackCarLoadsList addchild [SimpleDOMElement %AUTO% \
                                                    -tag "carLoad" \
                                                    -attributes [list name $LoadName]]
                    }
                    set needtype yes
                    foreach ctype [$locationTypeList getElementsByTagName carType] {
                        if {[$ctype attribute name] eq $JMRICarType} {
                            set needtype no
                            break
                        }
                    }
                    if {$needtype} {
                        $locationTypeList addchild [SimpleDOMElement %AUTO% \
                                                    -tag "carType" \
                                                    -attributes [list name $JMRICarType]]
                    }
                }
            }
        }
        set fp [open [file join $OutputDirectory $Filename_locations] w]
        $type WriteXMLHeader $fp
        $type WriteStylesheetHeader $fp $OPSXSLT_locations
        $type WriteDOCTYPEHeader $fp $OPSDTD_locations
        $operations_locations displayTree $fp
        close $fp 
        $operations_locations destroy
        set operations_trains [ParseXML %AUTO% {<operations-config/>}]
        set config_trains [$operations_trains getElementsByTagName operations-config]
        set comment [SimpleDOMElement %AUTO% -tag "!"]
        $comment setdata [format {Written by FCF2JMRIOperations %s on %s} \
                          $MRRSystem::FCFCLASSES_VERSION \
                          [clock format [clock seconds] -format {%+}]]
        $config_trains addchild $comment 
        set trains_node [SimpleDOMElement %AUTO% -tag "trains"]
        $config_trains addchild $trains_node
        set operations_routes [ParseXML %AUTO% {<operations-config/>}]
        set config_routes [$operations_routes getElementsByTagName operations-config]
        set comment [SimpleDOMElement %AUTO% -tag "!"]
        $comment setdata [format {Written by FCF2JMRIOperations %s on %s} \
                          $MRRSystem::FCFCLASSES_VERSION \
                          [clock format [clock seconds] -format {%+}]]
        $config_routes addchild $comment 
        set routes_node [SimpleDOMElement %AUTO% -tag "routes"]
        $config_routes addchild $routes_node
        
        set fp [open [file join $OutputDirectory $Filename_routes] w]
        $type WriteXMLHeader $fp
        $type WriteStylesheetHeader $fp $OPSXSLT_routes
        $type WriteDOCTYPEHeader $fp $OPSDTD_routes
        $operations_routes displayTree $fp
        close $fp
        $operations_routes destroy
        set fp [open [file join $OutputDirectory $Filename_trains] w]
        $type WriteXMLHeader $fp
        $type WriteStylesheetHeader $fp $OPSXSLT_trains
        $type WriteDOCTYPEHeader $fp $OPSDTD_trains
        $operations_trains displayTree $fp
        close $fp
        $operations_trains destroy
    }
    proc GetIndustryId {industry} {
        foreach indid [TheSystem IndustryIndexList] {
            if {$industry eq [TheSystem TheIndustry $indid]} {
                return $indid
            }
        }
        return 0
    }
    typevariable cartypeMap -array {
        "\]" Hopper
        "^" Hopper
        {%} Hopper
        {=} HopCoal
        {`} HopCoal
        {_} HopCoal
        "\{" HopCoal
        {;} HopCoal
        "\\" HopCoal
        {|} HopCoal
        "\}" HopCoal
        {~} HopCoal
        r Gon-scrap
        s Gondola
        t Gondola
        w Gondola
        x Gondola
        y Gondola
        z Gondola
        u Gondola
        v Gondola
        "\[" Gondola
        {<} Gondola
        {>} Gondola
        K Reefer
        L Reefer
        M Reefer
        N Reefer
        O Reefer
        {!} Boxcar
        {#} Boxcar
        {$} Boxcar
        {-} Boxcar
        {*} Boxcar
        {.} Boxcar
        {/} Boxcar
        {:} Boxcar
        0 Boxcar
        1 Boxcar
        2 Boxcar
        3 Boxcar
        4 Boxcar
        5 Boxcar
        6 Boxcar
        7 Boxcar
        8 Boxcar
        9 Boxcar
        A Boxcar
        B Boxcar
        j Boxcar
        E Baggage
        F Baggage
        G Baggage
        H Stock
        I Stock
        P Hopper
        Q Hopper
        R HopCmnt
        S HopChem
        Y HopSand
        T HopChem
        U HopGrain
        X Hopper
        V HopChem
        W HopGrain
        Z Hopper
        D HopSand
        {+} "Tank Oil"
        {(} "Tank Oil"
        {)} "Tank Oil"
        a "Tank Veg"
        b "Tank Food"
        c "Tank Oil"
        d "Tank Oil"
        e "Tank Oil"
        f "Tank Oil"
        g "Tank Oil"
        h "Tank Gas" 
        i "Tank Oil"
        C "Flatcar"
        J "FlatTimber"
        j "Flatcar" 
        k "Flatcar" 
        l "Flatcar" 
        m "Flatcar" 
        p "Flatcar" 
        o "Flatcar" 
        q "Flatcar" 
        {&} "Flatcar" 
        {@} "Flatcar" 
        n "Flatcar" 
    }
}

                                                                       
